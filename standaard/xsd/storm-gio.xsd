<?xml version="1.0" encoding="UTF-8"?>
<!--
  storm-gio.xsd — zelfstandig GIO-bestand. Namespace urn:storm:gio.
  Bundelt in één root de informatieobject-metadata + symbolisatie + de
  geometrie (voorheen verspreid over de AanleveringInformatieObject-wrapper
  en het losse .gml). Metadata/Symbolisatie/Geo worden verbatim bewaard
  (STOP imop-data / SE / imop-geo), zodat volledig <-> download verliesvrij is.
  Pakket: storm-volledig.xml verwijst via GeometrieRef (basisgeo:id) naar de
  Locaties in de Geo van deze bestanden.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:storm:gio"
           xmlns="urn:storm:gio"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="0.6.0">

  <xs:element name="GeoInformatieObject">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Identificatie" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="FRBRWork" type="xs:string"/>
              <xs:element name="FRBRExpression" type="xs:string" minOccurs="0"/>
              <xs:element name="soortWork" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- InformatieObject(Versie)Metadata + overige modules verbatim.
             Voor de download-IO-mappen (Identificatie/VersieMetadata/Metadata/
             Momentopname/JuridischeBorgingVan) worden de module-roots hier
             verbatim bewaard; de structuur-Identificatie hierboven blijft
             beschikbaar voor de aanlever-GIO-wrappers. -->
        <xs:element name="Metadata" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="##other" processContents="lax"
                      minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- FeatureTypeStyle (SE) verbatim -->
        <xs:element name="Symbolisatie" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="##other" processContents="lax"
                      minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- de geometrie/normwaarden (imop-geo) verbatim -->
        <!-- Geo optioneel: niet elk informatieobject heeft een GML-geometrie -->
        <xs:element name="Geo" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:any namespace="##other" processContents="lax"
                      maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <!-- herkomst voor verliesvrije reconstructie van de download-IO-map -->
      <xs:attribute name="map" type="xs:string"/>
      <xs:attribute name="geoBestand" type="xs:string"/>
      <xs:attribute name="symbBestand" type="xs:string"/>
      <!-- niet-XML informatieobject (bv. PDF): verbatim als los pakketbestand -->
      <xs:attribute name="bijlage" type="xs:string"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
