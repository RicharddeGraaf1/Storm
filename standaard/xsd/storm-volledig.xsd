<?xml version="1.0" encoding="UTF-8"?>
<!--
  storm-volledig.xsd — STORM-variant "volledig" (concept v0.6.0)

  Een FAITHFUL spiegel in één namespace (urn:storm:1.0) van STOP 1.4.1-tekst
  + IMOW 2.0-objecten + IMTR, met een gecombineerd manifest. Volledig doet
  ZELF geen transformatie: de tekst blijft puur (geen inline annotatie), de
  IMOW-annotaties staan als aparte objecten die via wId naar de tekst wijzen
  en via @ref naar elkaar. Geometrie blijft extern (Locatie -> GeometrieRef
  -> GIO-GML in de platte pakketmap).

  Grondslag: standaard/specificatie/volledig-objectinventaris.md
  Pakket: platte map met storm-volledig.xml + *.gml + manifest.xml
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:storm:1.0"
           xmlns="urn:storm:1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="0.6.0">

  <!-- ================================================================ -->
  <!-- Roots                                                            -->
  <!-- ================================================================ -->

  <xs:element name="Regeling">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Identificatie"/>
        <xs:element ref="Tekst"/>
        <xs:element ref="OwObjecten" minOccurs="0"/>
        <xs:element ref="Mutatie" minOccurs="0"/>
        <xs:element ref="ToepasbareRegels" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="variant" type="xs:string" fixed="volledig"/>
      <xs:attribute name="schemaversie" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Identificatie">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FRBRWork" type="xs:string"/>
        <xs:element name="FRBRExpression" type="xs:string" minOccurs="0"/>
        <xs:element name="soortWork" type="xs:string" minOccurs="0"/>
        <xs:element name="versienummer" type="xs:string" minOccurs="0"/>
        <xs:element name="bevoegdGezag" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!-- Gedeelde bouwstenen                                              -->
  <!-- ================================================================ -->

  <!-- STORM-eigen verwijzing (vervangt xlink:href van de bron; één ns) -->
  <xs:complexType name="Ref">
    <xs:attribute name="ref" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- STOP-tekst-identificatie (STOP: beide required; hier soepel) -->
  <xs:attributeGroup name="agTekstId">
    <xs:attribute name="eId" type="xs:string"/>
    <xs:attribute name="wId" type="xs:string"/>
  </xs:attributeGroup>

  <!-- IMOW NEN3610-identificatie -->
  <xs:simpleType name="NEN3610ID">
    <xs:restriction base="xs:string">
      <xs:pattern value="nl\.imow-(gm|pv|ws|mnre)[0-9]{1,6}\.[a-z]+\.[A-Za-z0-9]{1,32}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Waardelijst-verwijzing (bron: xs:anyURI met omgevingswet-pattern) -->
  <xs:simpleType name="WaardelijstURI">
    <xs:restriction base="xs:anyURI">
      <xs:pattern value="(http|https)://(wetgeving|standaarden|regelgeving)\.omgevingswet\.overheid\.nl/.*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="WaardeEenheid">
    <xs:sequence>
      <xs:element name="waarde" type="xs:decimal"/>
      <xs:element name="eenheid" type="WaardelijstURI"/>
    </xs:sequence>
  </xs:complexType>

  <!-- IMOW-objectbasis: status + procedurestatus (OWobject/OPRegeltekst) -->
  <xs:group name="gOwObject">
    <xs:sequence>
      <xs:element name="status" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="beëindigen"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="procedurestatus" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="ontwerp"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:group>

  <!-- ================================================================ -->
  <!-- LAAG 1 — STOP-tekst (puur; geen annotatie op de tekst)           -->
  <!-- ================================================================ -->

  <xs:element name="Tekst">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="RegelingOpschrift"/>
        <xs:element ref="Lichaam"/>
        <xs:element ref="Bijlage" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="ArtikelgewijzeToelichting" minOccurs="0"/>
      </xs:sequence>
      <!-- STOP-regelingstructuur: alle vier -->
      <xs:attribute name="structuur" default="compact">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="compact"/>
            <xs:enumeration value="vrijetekst"/>
            <xs:enumeration value="klassiek"/>
            <xs:enumeration value="tijdelijkdeel"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="RegelingOpschrift">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Al" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="agTekstId"/>
    </xs:complexType>
  </xs:element>

  <!-- Status-/leeg-elementen (child-elementen, geen attribuut) -->
  <xs:element name="Gereserveerd"><xs:complexType/></xs:element>
  <xs:element name="Vervallen"><xs:complexType/></xs:element>
  <xs:element name="NogNietInWerking"><xs:complexType/></xs:element>

  <xs:group name="gStatus">
    <xs:choice>
      <xs:element ref="Gereserveerd"/>
      <xs:element ref="Vervallen"/>
      <xs:element ref="NogNietInWerking"/>
    </xs:choice>
  </xs:group>

  <xs:group name="gStructuur">
    <xs:choice>
      <xs:element ref="Boek"/>
      <xs:element ref="Deel"/>
      <xs:element ref="Hoofdstuk"/>
      <xs:element ref="Titel"/>
      <xs:element ref="Afdeling"/>
      <xs:element ref="Paragraaf"/>
      <xs:element ref="Subparagraaf"/>
      <xs:element ref="Subsubparagraaf"/>
      <xs:element ref="Artikel"/>
      <xs:element ref="Divisie"/>
      <xs:element ref="Divisietekst"/>
    </xs:choice>
  </xs:group>

  <xs:complexType name="StructuurElement">
    <xs:sequence>
      <xs:element ref="Kop" minOccurs="0"/>
      <xs:group ref="gStatus" minOccurs="0"/>
      <xs:group ref="gStructuur" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="agTekstId"/>
  </xs:complexType>

  <xs:element name="Lichaam" type="StructuurElement"/>
  <xs:element name="Boek" type="StructuurElement"/>
  <xs:element name="Deel" type="StructuurElement"/>
  <xs:element name="Hoofdstuk" type="StructuurElement"/>
  <xs:element name="Titel" type="StructuurElement"/>
  <xs:element name="Afdeling" type="StructuurElement"/>
  <xs:element name="Paragraaf" type="StructuurElement"/>
  <xs:element name="Subparagraaf" type="StructuurElement"/>
  <xs:element name="Subsubparagraaf" type="StructuurElement"/>
  <xs:element name="Bijlage" type="StructuurElement"/>
  <xs:element name="ArtikelgewijzeToelichting" type="StructuurElement"/>

  <xs:element name="Artikel">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kop"/>
        <xs:choice>
          <xs:group ref="gStatus"/>
          <xs:element ref="Inhoud"/>
          <xs:element ref="Lid" maxOccurs="unbounded"/>
        </xs:choice>
      </xs:sequence>
      <xs:attributeGroup ref="agTekstId"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Lid">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="LidNummer" type="xs:string"/>
        <xs:choice>
          <xs:element ref="Vervallen"/>
          <xs:element ref="NogNietInWerking"/>
          <xs:element ref="Inhoud"/>
        </xs:choice>
      </xs:sequence>
      <xs:attributeGroup ref="agTekstId"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Divisie">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kop" minOccurs="0"/>
        <xs:element ref="InleidendeTekst" minOccurs="0"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="Divisie"/>
          <xs:element ref="Divisietekst"/>
        </xs:choice>
      </xs:sequence>
      <xs:attributeGroup ref="agTekstId"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Divisietekst">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kop" minOccurs="0"/>
        <xs:choice>
          <xs:group ref="gStatus"/>
          <xs:element ref="Inhoud"/>
        </xs:choice>
      </xs:sequence>
      <xs:attributeGroup ref="agTekstId"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Kop">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Label" type="xs:string" minOccurs="0"/>
        <xs:element name="Nummer" type="xs:string" minOccurs="0"/>
        <xs:element name="Opschrift" type="Tekstregel" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="InleidendeTekst">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kop" minOccurs="0"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Al"/>
          <xs:element ref="Lijst"/>
          <xs:element ref="Figuur"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Inhoud">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Al"/>
        <xs:element ref="Lijst"/>
        <xs:element ref="Begrippenlijst"/>
        <xs:element ref="Figuur"/>
        <xs:element ref="table"/>
        <xs:element ref="Tussenkop"/>
        <xs:element ref="Kadertekst"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- Blok -->
  <xs:element name="Al" type="Tekstregel"/>
  <xs:element name="Tussenkop" type="Tekstregel"/>

  <xs:element name="Lijst">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Lijstaanhef" type="Tekstregel" minOccurs="0"/>
        <xs:element ref="Li" maxOccurs="unbounded"/>
        <xs:element name="Lijstsluiting" type="Tekstregel" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Li">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="LiNummer" type="xs:string" minOccurs="0"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Al"/>
          <xs:element ref="Lijst"/>
          <xs:element ref="Figuur"/>
          <xs:element ref="table"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Begrippenlijst">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Begrip" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Begrip">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Term" type="Tekstregel"/>
        <xs:element name="Definitie">
          <xs:complexType>
            <xs:choice maxOccurs="unbounded">
              <xs:element ref="Al"/>
              <xs:element ref="Lijst"/>
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Kadertekst">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kop" minOccurs="0"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Al"/>
          <xs:element ref="Lijst"/>
          <xs:element ref="Figuur"/>
          <xs:element ref="table"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Figuur">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Titel" type="xs:string" minOccurs="0"/>
        <xs:element name="Illustratie">
          <xs:complexType>
            <xs:attribute name="naam" type="xs:string" use="required"/>
            <xs:attribute name="alt" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Bijschrift" type="Tekstregel" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- CALS-tabel (beknopt) -->
  <xs:element name="table">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="title" type="Tekstregel" minOccurs="0"/>
        <xs:element name="tgroup" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="colspec" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="colname" type="xs:string"/>
                  <xs:attribute name="colnum" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="thead" type="Rijenblok" minOccurs="0"/>
              <xs:element name="tbody" type="Rijenblok"/>
            </xs:sequence>
            <xs:attribute name="cols" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Rijenblok">
    <xs:sequence>
      <xs:element name="row" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="entry" type="Tekstregel" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Inline: mixed Tekstregel met opmaak, refs, noten -->
  <xs:complexType name="Tekstregel" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="i" type="Tekstregel"/>
      <xs:element name="b" type="Tekstregel"/>
      <xs:element name="u" type="Tekstregel"/>
      <xs:element name="strong" type="Tekstregel"/>
      <xs:element name="sup" type="xs:string"/>
      <xs:element name="sub" type="xs:string"/>
      <xs:element name="br"><xs:complexType/></xs:element>
      <xs:element name="IntRef" type="InlineRef"/>
      <xs:element name="ExtRef" type="InlineRef"/>
      <xs:element name="IntIoRef" type="InlineRef"/>
      <xs:element name="ExtIoRef" type="InlineRef"/>
      <xs:element ref="Noot"/>
      <xs:element name="Nootref">
        <xs:complexType><xs:attribute name="refid" type="xs:string"/></xs:complexType>
      </xs:element>
    </xs:choice>
    <xs:anyAttribute namespace="##other" processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="InlineRef" mixed="true">
    <xs:attribute name="ref" type="xs:anyURI"/>
    <xs:attribute name="soort" type="xs:string"/>
    <xs:attribute name="scope" type="xs:string"/>
    <xs:attributeGroup ref="agTekstId"/>
  </xs:complexType>

  <xs:element name="Noot">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NootNummer" type="xs:string"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Al"/>
          <xs:element ref="Lijst"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!-- Besluit/mutatie (STOP) — faithful eerste pass                    -->
  <!-- ================================================================ -->

  <xs:element name="Mutatie">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="RegelingMutatie" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="WijzigArtikel" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="componentnaam" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="RegelingMutatie">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="VoegToe" type="Wijzigactie"/>
        <xs:element name="Vervang" type="Wijzigactie"/>
        <xs:element name="Verwijder" type="Wijzigactie"/>
        <xs:element name="VervangKop" type="Wijzigactie"/>
      </xs:choice>
      <xs:attribute name="componentnaam" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Wijzigactie">
    <xs:sequence>
      <xs:group ref="gStructuur" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="wat" type="xs:string"/>
    <xs:attribute name="positie" type="xs:string"/>
    <xs:attribute name="context" type="xs:string"/>
  </xs:complexType>

  <xs:element name="WijzigArtikel">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kop"/>
        <xs:element name="Wat" type="xs:string" minOccurs="0"/>
        <xs:element ref="RegelingMutatie" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="agTekstId"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!-- LAAG 2 — IMOW-objecten (faithful; via wId/@ref gekoppeld)        -->
  <!-- Eén OwObjecten met thematische sub-secties                       -->
  <!-- ================================================================ -->

  <xs:element name="OwObjecten">
    <xs:complexType>
      <xs:all>
        <xs:element ref="Regels" minOccurs="0"/>
        <xs:element ref="Normen" minOccurs="0"/>
        <xs:element ref="Activiteiten" minOccurs="0"/>
        <xs:element ref="Locaties" minOccurs="0"/>
        <xs:element ref="Gebiedsaanwijzingen" minOccurs="0"/>
        <xs:element ref="VrijeTekst" minOccurs="0"/>
        <xs:element ref="Kaarten" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>

  <!-- Regels -->
  <xs:element name="Regels">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Regeltekst" minOccurs="0" maxOccurs="unbounded"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="RegelVoorIedereen"/>
          <xs:element ref="Instructieregel"/>
          <xs:element ref="Omgevingswaarderegel"/>
        </xs:choice>
        <xs:element ref="ActiviteitLocatieaanduiding" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="Regelingsgebied" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="Pons" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Regeltekst (: OPRegeltekst) — draagt @wId naar de STOP-tekst -->
  <xs:element name="Regeltekst">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="gerelateerdeRegeltekst" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="wId" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Gemeenschappelijke JuridischeRegel-kern -->
  <xs:group name="gJuridischeRegel">
    <xs:sequence>
      <xs:group ref="gOwObject"/>
      <xs:element name="identificatie" type="NEN3610ID"/>
      <xs:element name="idealisatie" type="WaardelijstURI"/>
      <xs:element name="artikelOfLid" type="Ref"/>
      <xs:element name="thema" type="WaardelijstURI"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="locatieaanduiding" type="Ref" maxOccurs="unbounded"/>
      <xs:element name="gebiedsaanwijzing" type="Ref"
                  minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="kaartaanduiding" type="Ref"
                  minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <xs:element name="RegelVoorIedereen">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gJuridischeRegel"/>
        <xs:element name="activiteitaanduiding" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="activiteit" type="Ref"/>
              <xs:element name="activiteitLocatieaanduiding" type="Ref"
                          minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="omgevingsnormaanduiding" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Instructieregel">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gJuridischeRegel"/>
        <xs:element name="instructieregelInstrument" type="WaardelijstURI"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="instructieregelTaakuitoefening" type="WaardelijstURI"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="omgevingsnormaanduiding" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Omgevingswaarderegel">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gJuridischeRegel"/>
        <xs:element name="omgevingswaardeaanduiding" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ActiviteitLocatieaanduiding">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="activiteitregelkwalificatie" type="WaardelijstURI"/>
        <xs:element name="locatieaanduiding" type="Ref" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Regelingsgebied">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="locatieaanduiding" type="Ref"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Pons">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="locatieaanduiding" type="Ref"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Normen -->
  <xs:element name="Normen">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="Omgevingsnorm"/>
          <xs:element ref="Omgevingswaarde"/>
        </xs:choice>
        <xs:element ref="Normwaarde" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:group name="gNorm">
    <xs:sequence>
      <xs:group ref="gOwObject"/>
      <xs:element name="identificatie" type="NEN3610ID"/>
      <xs:element name="naam" type="xs:string"/>
      <xs:element name="type" type="WaardelijstURI"/>
      <xs:element name="eenheid" type="WaardeEenheid" minOccurs="0"/>
      <xs:element name="normwaarde" type="Ref" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <xs:element name="Omgevingsnorm">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gNorm"/>
        <xs:element name="groep" type="WaardelijstURI"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Omgevingswaarde">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gNorm"/>
        <xs:element name="groep" type="WaardelijstURI"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Normwaarde">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="kwalitatieveWaarde" type="xs:string" minOccurs="0"/>
        <xs:element name="kwantitatieveWaarde" type="xs:decimal" minOccurs="0"/>
        <xs:element name="waardeInRegeltekst" type="xs:string" minOccurs="0"/>
        <xs:element name="locatieaanduiding" type="Ref" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Activiteiten -->
  <xs:element name="Activiteiten">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Activiteit" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Activiteit">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="naam" type="xs:string"/>
        <xs:element name="groep" type="WaardelijstURI"/>
        <xs:element name="gerelateerdeActiviteit" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="bovenliggendeActiviteit" type="Ref"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Locaties -->
  <xs:element name="Locaties">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Gebied"/>
        <xs:element ref="Gebiedengroep"/>
        <xs:element ref="Punt"/>
        <xs:element ref="Puntengroep"/>
        <xs:element ref="Lijn"/>
        <xs:element ref="Lijnengroep"/>
        <xs:element ref="Ambtsgebied"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:group name="gLocatie">
    <xs:sequence>
      <xs:group ref="gOwObject"/>
      <xs:element name="identificatie" type="NEN3610ID"/>
      <xs:element name="noemer" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:group>

  <!-- geometrie: verwijzing naar externe GIO-GML (basisgeo:id) -->
  <xs:complexType name="GeometrieHouder">
    <xs:sequence>
      <xs:element name="geometrie">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="GeometrieRef" type="Ref"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Gebied">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="hoogte" type="WaardeEenheid" minOccurs="0"/>
        <xs:element name="geometrie">
          <xs:complexType>
            <xs:sequence><xs:element name="GeometrieRef" type="Ref"/></xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Punt">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="geometrie">
          <xs:complexType>
            <xs:sequence><xs:element name="GeometrieRef" type="Ref"/></xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="hoogte" type="WaardeEenheid" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Lijn">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="hoogte" type="WaardeEenheid" minOccurs="0"/>
        <xs:element name="geometrie">
          <xs:complexType>
            <xs:sequence><xs:element name="GeometrieRef" type="Ref"/></xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Gebiedengroep">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="groepselement" type="Ref" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Puntengroep">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="groepselement" type="Ref" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Lijnengroep">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="groepselement" type="Ref" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Ambtsgebied">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gLocatie"/>
        <xs:element name="bestuurlijkeGrenzenVerwijzing">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="bestuurlijkeGrenzenID" type="xs:string"/>
              <xs:element name="domein" type="xs:string"/>
              <xs:element name="geldigOp" type="xs:date"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Gebiedsaanwijzingen -->
  <xs:element name="Gebiedsaanwijzingen">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Gebiedsaanwijzing" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Gebiedsaanwijzing">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="type" type="WaardelijstURI"/>
        <xs:element name="naam" type="xs:string"/>
        <xs:element name="groep" type="WaardelijstURI"/>
        <xs:element name="locatieaanduiding" type="Ref" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Vrije tekst -->
  <xs:element name="VrijeTekst">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Tekstdeel" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="OwDivisie" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="OwDivisietekst" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="Hoofdlijn" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Tekstdeel">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="idealisatie" type="WaardelijstURI" minOccurs="0"/>
        <xs:element name="thema" type="WaardelijstURI"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="divisieaanduiding" type="Ref"/>
        <xs:element name="hoofdlijnaanduiding" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="kaartaanduiding" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="locatieaanduiding" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="gebiedsaanwijzing" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- OwDivisie/OwDivisietekst: IMOW-objectkant (: OPRegeltekst, @wId),
       onderscheiden van de STOP-tekst-Divisie(tekst) hierboven -->
  <xs:element name="OwDivisie">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
      </xs:sequence>
      <xs:attribute name="wId" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="OwDivisietekst">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
      </xs:sequence>
      <xs:attribute name="wId" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Hoofdlijn">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="soort" type="xs:string"/>
        <xs:element name="naam" type="xs:string"/>
        <xs:element name="gerelateerdeHoofdlijn" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Kaarten -->
  <xs:element name="Kaarten">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kaart" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="SymbolisatieItem" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Kaart">
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="gOwObject"/>
        <xs:element name="identificatie" type="NEN3610ID"/>
        <xs:element name="naam" type="xs:string"/>
        <xs:element name="nummer" type="xs:string" minOccurs="0"/>
        <xs:element name="uitsnede">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="minX" type="xs:decimal"/>
              <xs:element name="minY" type="xs:decimal"/>
              <xs:element name="maxX" type="xs:decimal"/>
              <xs:element name="maxY" type="xs:decimal"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Kaartlaag" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="gOwObject"/>
              <xs:element name="identificatie" type="NEN3610ID"/>
              <xs:element name="naam" type="xs:string" minOccurs="0"/>
              <xs:element name="niveau" type="xs:integer"/>
              <xs:element name="activiteitlocatieweergave" type="Ref"
                          minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="normweergave" type="Ref"
                          minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="gebiedsaanwijzingweergave" type="Ref"
                          minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="SymbolisatieItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="symboolcode">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="[a-z]{2,4}[0-9]{3}"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="activiteitLocatieaanduidingSymbolisatie" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="gebiedsaanwijzingSymbolisatie" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="normwaardeSymbolisatie" type="Ref"
                    minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!-- LAAG 3 — IMTR (toepasbare regels; verbatim DMN ingebed)          -->
  <!-- ================================================================ -->

  <xs:element name="ToepasbareRegels">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ToepasbareActiviteit" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Beslislogica" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:any namespace="##other" processContents="skip"
                            minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="activiteitRef" type="xs:string"/>
            <xs:attribute name="soort" type="xs:string"/>
            <xs:attribute name="naam" type="xs:string"/>
            <xs:attribute name="namespace" type="xs:string"/>
            <xs:attribute name="geldigBegindatum" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!-- Manifest — gecombineerd (STOP manifest.xml + IMOW manifest-ow)   -->
  <!-- ================================================================ -->

  <xs:element name="Manifest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="regeling" type="Ref"/>
        <xs:element name="doel" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="Bestand" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="naam" type="xs:string" use="required"/>
            <xs:attribute name="rol" type="xs:string" use="required"/>
            <xs:attribute name="contentType" type="xs:string"/>
            <!-- voor GIO-bestanden: -->
            <xs:attribute name="work" type="xs:string"/>
            <xs:attribute name="objecttype" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="schemaversie" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
