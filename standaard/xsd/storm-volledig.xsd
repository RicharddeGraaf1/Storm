<?xml version="1.0" encoding="UTF-8"?>
<!--
  storm-volledig.xsd — envelop van de STORM-variant "volledig" (concept v0.6.0)

  Een faithful spiegel van STOP 1.4.1-tekst + IMOW 2.0-objecten + IMTR,
  opgeknipt in drie STORM-eigen namespaces zodat de bron-namen verbatim
  behouden blijven (geen hernoemen; STOP-Divisie en IMOW-Divisie leven in
  aparte namespaces):
    urn:storm:tekst  (storm-tekst.xsd)  — pure STOP-tekst
    urn:storm:ow     (storm-ow.xsd)     — IMOW-objecten (één OwObjecten)
    urn:storm:tr     (storm-tr.xsd)     — IMTR toepasbare regels
    urn:storm:basis  (storm-basis.xsd)  — gedeelde types (@ref, id's)

  Deze envelop (urn:storm:1.0) bindt de lagen samen in Regeling en definieert
  het gecombineerde Manifest. Volledig doet zelf geen transformatie; geometrie
  blijft extern (Locatie -> GeometrieRef -> GIO-GML in de platte pakketmap).

  Grondslag: standaard/specificatie/volledig-objectinventaris.md
  Pakket: platte map met storm-volledig.xml + *.gml + manifest.xml
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:b="urn:storm:basis"
           xmlns:tekst="urn:storm:tekst"
           xmlns:ow="urn:storm:ow"
           xmlns:tr="urn:storm:tr"
           targetNamespace="urn:storm:1.0"
           xmlns="urn:storm:1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="0.6.0">

  <xs:import namespace="urn:storm:basis" schemaLocation="storm-basis.xsd"/>
  <xs:import namespace="urn:storm:tekst" schemaLocation="storm-tekst.xsd"/>
  <xs:import namespace="urn:storm:ow"    schemaLocation="storm-ow.xsd"/>
  <xs:import namespace="urn:storm:tr"    schemaLocation="storm-tr.xsd"/>

  <!-- Root -->
  <xs:element name="Regeling">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Identificatie"/>
        <xs:element ref="tekst:Tekst"/>
        <xs:element ref="ow:OwObjecten" minOccurs="0"/>
        <xs:element ref="tekst:Mutatie" minOccurs="0"/>
        <xs:element ref="tr:ToepasbareRegels" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="variant" type="xs:string" fixed="volledig"/>
      <xs:attribute name="schemaversie" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Identificatie">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FRBRWork" type="xs:string"/>
        <xs:element name="FRBRExpression" type="xs:string" minOccurs="0"/>
        <xs:element name="soortWork" type="xs:string" minOccurs="0"/>
        <xs:element name="versienummer" type="xs:string" minOccurs="0"/>
        <xs:element name="bevoegdGezag" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Gecombineerd Manifest (STOP manifest.xml + IMOW manifest-ow.xml) -->
  <xs:element name="Manifest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="regeling" type="b:Ref"/>
        <xs:element name="doel" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="Bestand" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="naam" type="xs:string" use="required"/>
            <xs:attribute name="rol" type="xs:string" use="required"/>
            <xs:attribute name="contentType" type="xs:string"/>
            <xs:attribute name="work" type="xs:string"/>
            <xs:attribute name="objecttype" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="schemaversie" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
